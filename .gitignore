# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies & Python virtual environments
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.venv/
__pycache__/
*.py[cod]

# Next.js, TypeScript & build outputs
/.next/
/out/
/build/
/coverage/
*.tsbuildinfo
next-env.d.ts

# Cloudflare Workers, OpenNext & Wrangler local state
/.open-next/
/.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Local SQLite databases, D1 dumps & backups
/data/
/backups/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sql.gz
*.sha256

# Logs, archives & local notes
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
*.log
*.zip
note_shop_thucduongphuctho

# OS & editor temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
