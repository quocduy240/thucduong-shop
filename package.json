{
  "name": "thucduong-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-opennext-build.mjs",
    "dev": "next dev",
    "build:next": "next build",
    "build": "opennextjs-cloudflare build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:db:local": "wrangler d1 execute thucduong-shop-db --local --file=data/d1-dump.sql --yes",
    "cf:db:remote": "wrangler d1 execute thucduong-shop-db --remote --file=data/d1-dump.sql --yes",
    "import:post": "node scripts/import-post.mjs",
    "import:products": "node scripts/import-products.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npx --yes tsx --test lib/html-extract.test.ts lib/rate-limit.test.ts lib/checkout-helpers.test.ts lib/logger.test.ts lib/rbac.test.ts lib/media-security.test.ts lib/image-url.test.ts lib/backup-verify.test.ts",
    "security:check": "npm audit --omit=dev --audit-level=high && npm run typecheck"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "^4.164.0"
  }
}
